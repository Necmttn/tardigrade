{
  "name": "tardie",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Clavia, Inc.",
  "description": "Actor, agent, client, and host APIs for Tardigrade.",
  "homepage": "https://github.com/clavia-labs/tardigrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/tardigrade.git",
    "directory": "packages/tardie"
  },
  "bugs": {
    "url": "https://github.com/clavia-labs/tardigrade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "exports": {
    "./core": "./src/core.ts",
    "./agent": "./src/agent.ts",
    "./bun": "./src/bun.ts",
    "./cloudflare": "./src/cloudflare.ts",
    "./libraries": "./src/libraries.ts",
    "./worker-loader": "./src/worker-loader.ts",
    ".": "./src/index.ts",
    "./core/runtime": "./src/core/runtime.ts",
    "./core/services": "./src/core/services.ts",
    "./agent/services": "./src/agent/services.ts",
    "./deprecated": "./src/deprecated/index.ts",
    "./deprecated/core": "./src/deprecated/core.ts",
    "./deprecated/agent": "./src/deprecated/agent.ts",
    "./deprecated/platform/bun": "./src/deprecated/platform/bun.ts",
    "./deprecated/platform/cloudflare": "./src/deprecated/platform/cloudflare.ts",
    "./deprecated/agent/component/code": "./src/deprecated/agent/component/code.ts",
    "./deprecated/agent/testing": "./src/agent-testing.ts",
    "./deprecated/code": "./src/code.ts",
    "./deprecated/actor/*": "./src/actor/*.ts",
    "./deprecated/component/*": "./src/component/*.ts",
    "./deprecated/log/*": "./src/log/*.ts",
    "./deprecated/output/*": "./src/output/*.ts",
    "./deprecated/packages/*": "./src/packages/*.ts",
    "./deprecated/projection/*": "./src/projection/*.ts",
    "./deprecated/runtime/*": "./src/runtime/*.ts",
    "./deprecated/component/infer/*": "./src/component/infer/*.ts",
    "./deprecated/testing": "./src/testing.ts",
    "./deprecated/model/*": "./src/model/*.ts",
    "./deprecated/core/actor": "./src/deprecated/core/actor.ts",
    "./model/*": "./src/model/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@clavia/tardigrade-deprecated-agent": "workspace:*",
    "@clavia/tardigrade-deprecated-core": "workspace:*",
    "@clavia/tardigrade-deprecated-code": "workspace:*",
    "effect": "4.0.0-rc.115",
    "@clavia/tardigrade-deprecated-bun": "workspace:*",
    "@clavia/tardigrade-core": "workspace:*",
    "@clavia/tardigrade-platform": "workspace:*",
    "@clavia/tardigrade-agent": "workspace:*",
    "@clavia/tardigrade-libraries": "workspace:*",
    "@clavia/tardigrade-deprecated-cloudflare": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1"
  }
}
