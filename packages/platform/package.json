{
  "name": "@clavia/tardigrade-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./bun": "./src/bun/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./worker-loader/*": "./src/shared/worker-loader/*.ts"
  },
  "dependencies": {
    "@clavia/tardigrade-deprecated-bun": "workspace:*",
    "@clavia/tardigrade-deprecated-code": "workspace:*",
    "@clavia/tardigrade-deprecated-cloudflare": "workspace:*",
    "@clavia/tardigrade-core": "workspace:*",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10",
    "@clavia/tardigrade-agent": "workspace:*",
    "@clavia/tardigrade-libraries": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/bun src/shared/worker-loader",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:worker-loader": "vitest run --config vitest.worker-loader.config.ts",
    "test:celld": "bun run test/worker-loader/celld/run.ts"
  }
}
