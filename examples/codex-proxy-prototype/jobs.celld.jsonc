{
  "name": "tardigrade-jobs-prototype",
  "main": "src/jobs-worker.ts",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "tardigrade-jobs-prototype" }],
    "consumers": [{
      "queue": "tardigrade-jobs-prototype",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 1,
      "max_retries": 3,
      "retry_delay": 30,
      "dead_letter_queue": "tardigrade-jobs-prototype-failed"
    }]
  },
  "vars": {
    "JOB_TEXT": "Produce the scheduled report.",
    "TARDIGRADE_MESSAGE_URL": "http://127.0.0.1:8080/v1/actors/tardie/threads/main/methods/message"
  }
}
